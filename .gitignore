# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Built corpus artefacts (regenerate with the ingest script)
data/corpus/*.bin
data/corpus/*.json

# Runtime state (per-user credit balances)
data/credits.json
data/credits.json.tmp
# Last version posted to the update channel (src/announce.js)
data/announced-version.txt
# Feature suggestions from the server (src/suggestions.js)
data/suggestions.jsonl

# Source texts (large; keep out of git)
data/raw/

# OS noise
.DS_Store

# SDD scratch workspace
.superpowers/
