# Copy to .env and fill in. .env is gitignored and must never be committed.

# Discord — from the Developer Portal. Treat as a password.
DISCORD_BOT_TOKEN=REDACTED-ROTATED-TOKEN
DISCORD_GUILD_ID=<guild-id>
# Comma-separated channel IDs the bot may read and speak in.
DISCORD_ALLOWED_CHANNELS=<channel-id>

# LM Studio (OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:1234/v1
LLM_CHAT_MODEL=qwen3.6-27b-mlx
LLM_JUDGE_MODEL=qwen3-4b-instruct-2507-mlx
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Trigger tuning
TRIGGER_SIMILARITY_FLOOR=0.65
TRIGGER_COOLDOWN_SECONDS=180
TRIGGER_ENABLED=true
MAX_QUOTE_CHARS=400
