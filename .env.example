# Copy to .env and fill in. .env is gitignored and must never be committed.

# Discord — from the Developer Portal. Treat as a password.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated channel IDs the bot may read and speak in.
DISCORD_ALLOWED_CHANNELS=

# LM Studio (OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:1234/v1
LLM_CHAT_MODEL=
LLM_JUDGE_MODEL=
LLM_EMBED_MODEL=

# Trigger tuning
TRIGGER_SIMILARITY_FLOOR=0.45
TRIGGER_COOLDOWN_SECONDS=180
TRIGGER_ENABLED=true
MAX_QUOTE_CHARS=400
