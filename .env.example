# Copy to .env and fill in. .env is gitignored and must never be committed.

# Discord — from the Developer Portal. Treat as a password.
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-guild-id-here
# Comma-separated channel IDs the bot may read and speak in. Must be filled
# in — left empty, the bot connects but responds to nothing.
DISCORD_ALLOWED_CHANNELS=
# Everywhere in these servers, instead of naming each channel. Comma-separated
# server (guild) IDs. A channel list goes stale as soon as someone adds a
# channel; this does not. Leave empty to use DISCORD_ALLOWED_CHANNELS only.
DISCORD_ALLOWED_GUILDS=
# Channels to keep Lu out of within those servers -- mod channels, private
# ones. Comma-separated channel IDs. Only narrows DISCORD_ALLOWED_GUILDS; it
# does not override a channel named explicitly in DISCORD_ALLOWED_CHANNELS.
DISCORD_DENIED_CHANNELS=
# Channel ID where Lu posts his version and what changed each time he starts on
# a new version (see CHANGELOG.md). Leave empty to turn it off.
UPDATE_CHANNEL_ID=

# Ollama, bound to loopback on the host running the bot.
LLM_BASE_URL=http://127.0.0.1:11434/v1
# One model serves both roles so only one copy occupies RAM.
LLM_CHAT_MODEL=qwen3:4b-instruct
LLM_JUDGE_MODEL=qwen3:4b-instruct
LLM_EMBED_MODEL=nomic-embed-text

# Optional: a separate, smaller model for the "is this aimed at Lu?" check.
# Defaults to LLM_JUDGE_MODEL.
# LLM_ADDRESSEE_MODEL=

# Trigger tuning
TRIGGER_SIMILARITY_FLOOR=0.65
# Cooldown applies to random chime-ins only.
TRIGGER_COOLDOWN_SECONDS=60
# false = only answer @mentions, replies to Lu, and his name.
TRIGGER_ENABLED=true
MAX_QUOTE_CHARS=400
TRIGGER_KEYWORDS=lu,ai bot
RANDOM_REPLY_CHANCE=0.02
ATTENTION_WINDOW_MESSAGES=8
ATTENTION_WINDOW_MINUTES=5
PAUSE_SECONDS=3
ADDRESSEE_TIMEOUT_SECONDS=30
REPLY_TIMEOUT_SECONDS=90
# Hard cap on a reply's length. The persona asks for 2-3 sentences; this only
# catches the occasional wall of text.
REPLY_MAX_TOKENS=120

# Conversation memory per channel. When full, keep only the newest HISTORY_TRIM_TO.
HISTORY_LIMIT=20
HISTORY_TRIM_TO=10

# Lu can change his own Discord nickname when asked in chat.
NICKNAME_ENABLED=true
# Matches the original bot: only members with the Manage Nicknames permission
# may ask. Set to false to let anyone ask.
NICKNAME_REQUIRE_PERMISSION=true

# --- Imperial Credits ---
# Members earn credits for taking part in chat; credits become a level.
# Master switch. Set to false to turn the ledger off entirely.
CREDITS_ENABLED=true
# Credits awarded per eligible message, picked uniformly from this range.
# MEE6's values, kept so a level here means what it means in other servers.
CREDITS_MIN=15
CREDITS_MAX=25
# Shortest gap between two paying messages from the same person. MEE6 uses 60;
# 30 suits a small server where conversation arrives in bursts.
CREDITS_COOLDOWN_SECONDS=30
# Messages shorter than this earn nothing.
CREDITS_MIN_CHARS=3
# Post a line in the channel when someone reaches a new level.
# Turn off if it gets noisy -- this is the only time Lu speaks unprompted.
CREDITS_ANNOUNCE_LEVEL_UP=true
# How long to wait after the last award before writing balances to disk.
CREDITS_FLUSH_MS=2000
# Chance that Lu is told the speaker's balance when nobody has raised the
# subject. He is always told it when somebody does mention credits, levels, the
# leaderboard or the ledger. This used to be, in effect, 1.0 -- the balance was
# in every prompt -- which is why he mentioned credits in almost every reply.
# 0 means he only ever has it when asked; 1 restores the old behaviour.
CREDITS_MENTION_CHANCE=0.15

# --- Mischief modes ---
# Which Lu answers. One mode is picked per reply and committed to fully; the
# model never sees the other three, so it has nothing to average against.
# Master switch. Set to false and every reply comes out in the plain voice.
MOOD_ENABLED=true
# Relative weights, not percentages -- they are normalised by their total, and
# only default to a mix summing to 100 because that is how they read when being
# tuned. Set one to 0 to retire that mode without deleting it.
# gossip: talks about you to the channel rather than to you, and stirs.
MOOD_WEIGHT_GOSSIP=35
# needler: agrees enthusiastically, in a way that is plainly not agreement.
MOOD_WEIGHT_NEEDLER=30
# narrator: states something absurd as settled fact and does not blink.
MOOD_WEIGHT_NARRATOR=20
# windup: misreads you into a position you did not take, then argues with it.
# Deliberately the smallest share -- it ages fastest and starts real arguments.
MOOD_WEIGHT_WINDUP=15
